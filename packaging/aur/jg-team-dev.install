post_install() {
  cat <<'MSG'
==> jg-team-dev installed. To start:
      systemctl --user enable --now jg-team-dev-hub     # start the hub (and at every login)
    Then open "jg-team-dev" from your launcher and start a team session in a project folder.
MSG
}

post_upgrade() {
  cat <<'MSG'
==> Restart the hub to use the new version:
      systemctl --user restart jg-team-dev-hub
MSG
}
