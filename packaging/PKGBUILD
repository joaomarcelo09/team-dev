# Maintainer: joaogomes <jmjoao73@hotmail.com>
#
# Builds the package from this source tree:
#     cd packaging && makepkg -si

pkgname=jg-team-dev
pkgver=0.1.0
pkgrel=6
pkgdesc="Chat with a Claude Code Coordinator that runs a team of worker sessions"
arch=('x86_64')
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'wayland' 'fontconfig' 'ttf-liberation')
makedepends=('cargo')
optdepends=(
  'vulkan-icd-loader: GPU-accelerated rendering'
  'claude-code: Claude Code agent sessions'
)
install=jg-team-dev.install
options=('!lto' '!debug')

_root() {
  realpath "$startdir/.."
}

build() {
  cd "$(_root)"
  export CARGO_TARGET_DIR="$(_root)/target"
  cargo build --release --locked --workspace
}

check() {
  cd "$(_root)"
  export CARGO_TARGET_DIR="$(_root)/target"
  cargo test --release --locked --workspace
}

package() {
  local root
  root="$(_root)"
  install -Dm755 "$root/target/release/jg-team-dev" "$pkgdir/usr/bin/jg-team-dev"
  install -Dm755 "$root/target/release/jg-team-dev-hub" "$pkgdir/usr/bin/jg-team-dev-hub"
  install -Dm755 "$root/target/release/jg-team-dev-desktop" "$pkgdir/usr/bin/jg-team-dev-desktop"
  install -Dm644 "$startdir/jg-team-dev-hub.service" "$pkgdir/usr/lib/systemd/user/jg-team-dev-hub.service"
  install -Dm644 "$startdir/jg-team-dev.desktop" "$pkgdir/usr/share/applications/jg-team-dev.desktop"
  install -Dm644 "$startdir/jg-team-dev.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/jg-team-dev.svg"
  install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/jg-team-dev/README.md"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/jg-team-dev/LICENSE"
}
